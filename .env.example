# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# OpenRouter (AI engine for SWOT + Plan + Daily Quiz + Motivation)
# Get one at https://openrouter.ai/keys — works with any OpenAI-compatible model.
# Default model: openai/gpt-4o-mini (fast, cheap, JSON-mode capable).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Cashfree Payment Gateway (₹99 plan unlock)
# Generate at https://merchant.cashfree.com/ → Developers → API Keys.
# Use CASHFREE_ENV=sandbox during testing, production once live.
CASHFREE_ENV=production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional override; defaults to 2025-01-01.
# CASHFREE_API_VERSION=2025-01-01

# Resend (email) — used by Supabase Custom SMTP and any future transactional mail
RESEND_API_KEY=
EMAIL_FROM=noreply@tranquilai.in

# Public site URL (no trailing slash). Production: https://prepinsight.in
# Render: set this in Environment. Local-only dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://prepinsight.in
