# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# OpenRouter (AI engine for SWOT + Plan + Daily Quiz + Motivation)
# Get one at https://openrouter.ai/keys — works with any OpenAI-compatible model.
# Default model: openai/gpt-4o-mini (fast, cheap, JSON-mode capable).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Razorpay hosted Payment Page (₹50 plan unlock)
NEXT_PUBLIC_RAZORPAY_PAGE_URL=https://rzp.io/rzp/w0QWVnV

# Resend (email) — used by Supabase Custom SMTP and any future transactional mail
RESEND_API_KEY=
EMAIL_FROM=noreply@tranquilai.in

# Public — production app (Vercel): https://app.prepinsight.in when www/apex use GitHub Pages
NEXT_PUBLIC_APP_URL=http://localhost:3000
